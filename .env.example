# 复制为 build/course-env.txt 或导出到环境后启动；生产部署务必全部注入
# JWT 密钥：≥32 字节随机串（生成：openssl rand -base64 48）
DEVHUB_JWT_SECRET=

# 数据库（本机 Docker 中间件示例）
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=devhub
MYSQL_USER=root
MYSQL_PASSWORD=

# 生产 profile 数据源（application-prod.yml 无默认值，二选一注入）
MYSQL_URL=jdbc:mysql://localhost:3307/devhub?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LLM（已有，勿提交真实值）
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
